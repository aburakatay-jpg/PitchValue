{
  "expo": {
    "name": "PitchValue",
    "slug": "pitchvalue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/pitchvalue-app-icon.png",
    "scheme": [
      "pitchvalue",
      "pitchvalue-dev"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pitchvalue.app",
      "icon": "./assets/icons/pitchvalue-app-icon.png"
    },
    "android": {
      "package": "com.pitchvalue.app",
      "icon": "./assets/icons/pitchvalue-app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icons/pitchvalue-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08111F"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a5bb4ba-d1e7-499f-ae41-1e9ca3688e94"
      }
    },
    "owner": "aburakatay"
  }
}
